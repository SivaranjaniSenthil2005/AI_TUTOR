# AI Tutor Environment Configuration (Example Template)
# Copy this file to .env and replace placeholder values with your actual API keys.
# Real keys belong only in .env (which is strictly gitignored). Never commit real keys.

# Optional LLM Provider API Keys (Only providers with a key configured will be enabled in the fallback chain)
GEMINI_API_KEY=your_gemini_api_key_here
GROQ_API_KEY=your_groq_api_key_here
MISTRAL_API_KEY=your_mistral_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# Privacy & Debugging (0 = metadata only logging, 1 = log full question/answer prompts for debugging)
DEBUG_LLM=0
DEBUG_RETRIEVAL=0

# Server Configuration
HOST=127.0.0.1
PORT=8000
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
